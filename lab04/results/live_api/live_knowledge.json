  "entries": [
    [
      "云山大学",
      "云山大学位于岭南省云州市，建于1958年，是省属重点大学，现有全日制本科生约2.1万人，校训为「格物致知」。春季学期3月2日开学、7月5日放暑假；秋季学期9月1日开学、次年1月15日放寒假。地铁3号线「云大站」距东门200米；校内校巴共5条线路，10分钟一班。",
      [
        "doc01",
        "doc12",
        "doc14"
      ]
    ],
    [
      "人工智能学院",
      "人工智能学院成立于2018年，首任及现任院长为王启明教授。学院下设机器学习系、智能科学系、认知计算系三个系。认知计算全国重点实验室依托人工智能学院建设。岭南超算中心由云山大学与省科技厅共建，计算机学院参与运行管理。人工智能学院与新加坡南洋理工大学有本科联合培养项目。",
      [
        "doc02",
        "doc10",
        "doc15"
      ]
    ],
    [
      "计算机学院",
      "计算机学院前身为1985年成立的计算机系，现任院长陈国峰教授，设计算机科学与技术、软件工程两个本科专业。认知计算全国重点实验室依托人工智能学院建设；岭南超算中心由云山大学与省科技厅共建，计算机学院参与运行管理。",
      [
        "doc03",
        "doc10"
      ]
    ],
    [
      "人工智能学院教师",
      "人工智能学院教师包括李文瀚、赵婉晴和孙浩然。李文瀚为教授，2019年入职，研究方向为检索增强生成，主讲《大模型通识课》，并担任AI协会指导教师，该协会每周三晚组织论文研读。赵婉晴为副教授，研究方向为知识图谱，主讲《知识图谱导论》。孙浩然为讲师，研究方向为强化学习，并担任机器人战队指导教师，该战队每年参加全国机器人大赛。",
      [
        "doc04",
        "doc11"
      ]
    ],
    [
      "计算机学院教师",
      "计算机学院教师包括周天宇，教授，研究方向为分布式系统；林小雨，副教授，研究方向为数据库系统。",
      [
        "doc05"
      ]
    ],
    [
      "大模型通识课",
      "《大模型通识课》课程代码为AI2101，3学分、32学时，春季学期开设，授课教师李文瀚，面向全校本科生，无先修课程要求。",
      [
        "doc06"
      ]
    ],
    [
      "知识图谱导论",
      "《知识图谱导论》课程代码为AI3305，2学分，秋季学期开设，授课教师赵婉晴，面向人工智能学院研究生。该课程需先修《数据结构》。选课规则方面，本科生每学期最多修30学分；GPA低于2.0给予学术警告。",
      [
        "doc07",
        "doc08"
      ]
    ],
    [
      "奖学金体系",
      "奖学金体系包括国家奖学金、校长奖学金和云山一等奖学金。国家奖学金为8000元/年，评定比例约2%；校长奖学金为20000元/年，全校每年10人；云山一等奖学金为3000元/年，比例约5%。",
      [
        "doc09"
      ]
    ],
    [
      "学生社团与校园生活",
      "学生社团方面，AI协会由指导教师李文瀚负责，每周三晚组织论文研读；机器人战队由指导教师孙浩然负责，每年参加全国机器人大赛。校园生活方面，图书馆藏书380万册，开放时间为每天7:00-22:00；人工智能分馆位于理科楼B座3层，收藏大模型与智能体专题图书。",
      [
